# Copy this file to .env and fill in your OpenRouteService API key.
# The key is used only by the backend and is never exposed to the client.
# Values in this file act as defaults and documentation.

ORS_API_KEY=CHANGE_ME
MAINTENANCE_MODE=0
MAINTENANCE_KEY=
USE_ORS_REVERSE=0
# Random secret used to make stored visitor hashes harder to reverse.
STATS_HASH_SALT=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
# Minimum delay between calls to the upstream classifieds search.
SCRAPER_RATE_LIMIT_SECONDS=1.0
# Minimum delay for the server-side Nominatim fallback on unresolved route samples.
NOMINATIM_RATE_LIMIT_SECONDS=1.1
# Comma-separated exact hosts accepted by the restricted frontend proxy.
PROXY_ALLOW_HOSTS=nominatim.openstreetmap.org,www.kleinanzeigen.de
